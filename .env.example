# Railway: use the POOLED Neon connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
BROOST_ADMIN_PASSWORD=replace_with_a_strong_admin_password
BROOST_SYNC_KEY=replace_with_a_long_random_sync_key

# Optional. The default * supports Vercel preview URLs. Lock it to your final
# Vercel/custom domains later by separating values with commas.
CORS_ORIGINS=*

# Vercel only: the public Railway domain, without a trailing slash.
API_BASE_URL=https://your-service.up.railway.app
