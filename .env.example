# Railway: use the POOLED Neon connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
BROOST_ADMIN_PASSWORD=replace_with_a_strong_admin_password
BROOST_SYNC_KEY=replace_with_a_long_random_sync_key

# Optional production hardening and PostgreSQL pool sizing.
CORS_ORIGINS=https://broost-three.vercel.app
CORS_ORIGIN_REGEX=^https://broost(?:-[a-z0-9-]+)?\.vercel\.app$
DB_POOL_MAX_SIZE=5

# Vercel only: the public Railway domain, without a trailing slash.
API_BASE_URL=https://your-service.up.railway.app

# Windows POS build only. The build script stores just this URL and BROOST_SYNC_KEY.
BROOST_POS_SERVER_URL=https://your-service.up.railway.app
